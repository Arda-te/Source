--========================================================--
-- ANA DÖNGÜ
--========================================================--

RunService.Heartbeat:Connect(function()

	if not Humanoid or not Humanoid.Parent then
		return
	end

	-- GOD
	if Settings.God then

		Humanoid.MaxHealth = 100

		if Humanoid.Health < 100 then
			Humanoid.Health = 100
		end

	end

	-- SPEED
	if Settings.Sprint then
		Humanoid.WalkSpeed = 50
	elseif Settings.Speed then
		Humanoid.WalkSpeed = 100
	else
		Humanoid.WalkSpeed = WalkSpeed
	end

	-- JUMP
	Humanoid.UseJumpPower = true

	if Settings.Jump then
		Humanoid.JumpPower = 150
	else
		Humanoid.JumpPower = JumpPower
	end

	-- NOCLIP
	if Settings.Noclip and Character then

		for _,Object in ipairs(
			Character:GetDescendants()
		) do

			if Object:IsA("BasePart") then
				Object.CanCollide = false
			end

		end

	end

	-- FULLBRIGHT
	if Settings.FullBright then

		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false

	end

	-- FLY
	if Settings.Fly and Root then

		FlyGui.Visible = true

		local Camera =
			workspace.CurrentCamera

		local Direction = Vector3.zero

		if JoystickVector.Magnitude > .05 then

			Direction =
				Camera.CFrame.LookVector
				* (-JoystickVector.Y)

				+ Camera.CFrame.RightVector
				* JoystickVector.X

		end

		if Settings.Hover then

			Root.AssemblyLinearVelocity =
				Vector3.zero

		elseif Direction.Magnitude > .05 then

			Root.AssemblyLinearVelocity =
				Direction.Unit * FlySpeed

		else

			Root.AssemblyLinearVelocity =
				Vector3.zero

		end

	else

		FlyGui.Visible = false

	end

end)

