local function button(text, icon, callback)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-6,0,55)
	b.BackgroundColor3 = Color3.fromRGB(27,27,33)
	b.BorderSizePixel = 0
	b.Text = icon.."   "..text
	b.TextColor3 = Color3.fromRGB(240,240,245)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.AutoButtonColor = false
	b.Parent = Scroll

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,13)
	c.Parent = b

	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(65,65,75)
	s.Parent = b

	b.Activated:Connect(function()
		callback(b,s)
	end)

	return b
end

local function toggle(b,s,on,name)
	if on then
		b.Text = name.."   • AÇIK"
		b.BackgroundColor3 = Color3.fromRGB(125,0,20)
		s.Color = Color3.fromRGB(255,30,45)
	else
		b.Text = name.."   • KAPALI"
		b.BackgroundColor3 = Color3.fromRGB(27,27,33)
		s.Color = Color3.fromRGB(65,65,75)
	end
end

