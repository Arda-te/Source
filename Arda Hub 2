local function makeButton(text,icon,callback)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-6,0,55)
	b.BackgroundColor3 = Color3.fromRGB(27,27,33)
	b.BorderSizePixel = 0
	b.Text = icon.."   "..text
	b.TextColor3 = Color3.new(1,1,1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.AutoButtonColor = false
	b.Parent = scroll

	Instance.new("UICorner",b).CornerRadius = UDim.new(0,13)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(65,65,75)
	stroke.Parent = b

	b.Activated:Connect(function()
		callback(b,stroke)
	end)
end

local function toggle(b,s,on,name)
	if on then
		b.Text = name.." • AÇIK"
		b.BackgroundColor3 = Color3.fromRGB(130,0,20)
		s.Color = Color3.fromRGB(255,30,45)
	else
		b.Text = name.." • KAPALI"
		b.BackgroundColor3 = Color3.fromRGB(27,27,33)
		s.Color = Color3.fromRGB(65,65,75)
	end
end

