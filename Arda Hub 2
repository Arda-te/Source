local JoystickVector = Vector2.zero
local JoystickDragging = false

local function UpdateJoystick(Position)

	local Center =
		Base.AbsolutePosition
		+ Base.AbsoluteSize / 2

	local Delta =
		Vector2.new(
			Position.X - Center.X,
			Position.Y - Center.Y
		)

	local Radius = 45

	if Delta.Magnitude > Radius then
		Delta = Delta.Unit * Radius
	end

	JoystickVector =
		Vector2.new(
			Delta.X / Radius,
			Delta.Y / Radius
		)

	Stick.Position =
		UDim2.new(
			.5,
			Delta.X - 32.5,
			.5,
			Delta.Y - 32.5
		)

end

Base.InputBegan:Connect(function(Input)

	if Input.UserInputType ==
		Enum.UserInputType.Touch
		or Input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		JoystickDragging = true
		UpdateJoystick(Input.Position)

	end

end)

UIS.InputChanged:Connect(function(Input)

	if not JoystickDragging then
		return
	end

	if Input.UserInputType ==
		Enum.UserInputType.Touch
		or Input.UserInputType ==
		Enum.UserInputType.MouseMovement then

		UpdateJoystick(Input.Position)

	end

end)

UIS.InputEnded:Connect(function(Input)

	if Input.UserInputType ==
		Enum.UserInputType.Touch
		or Input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		JoystickDragging = false

		JoystickVector =
			Vector2.zero

		Stick.Position =
			UDim2.new(.5,-32.5,.5,-32.5)

	end

end)

