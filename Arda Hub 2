-- Ana döngü
RunService.Heartbeat:Connect(function()

	if not hum or not hum.Parent then
		return
	end

	-- Canı 100'de tut
	if state.God then
		hum.MaxHealth = 100
		if hum.Health < 100 then
			hum.Health = 100
		end
	end

	hum.WalkSpeed = state.Speed and 100 or 16
	hum.UseJumpPower = true
	hum.JumpPower = state.Jump and 150 or 50

	if state.Noclip and char then
		for _,v in ipairs(char:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CanCollide = false
			end
		end
	end

	if state.Fly and root then
		flyGui.Visible = true

		local camera = workspace.CurrentCamera
		local direction = Vector3.zero

		if joystick.Magnitude > .05 then
			direction =
				camera.CFrame.LookVector * (-joystick.Y)
				+ camera.CFrame.RightVector * joystick.X
		end

		if state.Hover then
			root.AssemblyLinearVelocity = Vector3.zero
		elseif direction.Magnitude > .05 then
			root.AssemblyLinearVelocity = direction.Unit * flySpeed
		else
			root.AssemblyLinearVelocity = Vector3.zero
		end
	else
		flyGui.Visible = false
	end
end)

