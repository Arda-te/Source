--========================================================
-- JOYSTICK
--========================================================

local function updateJoystick(position)

	local Center =
		FlyBase.AbsolutePosition +
		FlyBase.AbsoluteSize / 2

	local Delta =
		Vector2.new(
			position.X-Center.X,
			position.Y-Center.Y
		)

	local Radius = 45

	if Delta.Magnitude > Radius then
		Delta = Delta.Unit * Radius
	end

	FlyDirection =
		Vector2.new(
			Delta.X/Radius,
			Delta.Y/Radius
		)

	Stick.Position =
		UDim2.new(
			.5,
			Delta.X-30,
			.5,
			Delta.Y-30
		)

end

FlyBase.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.Touch then

		FlyDragging = true
		updateJoystick(input.Position)

	end

end)

UIS.InputChanged:Connect(function(input)

	if FlyDragging and
		input.UserInputType ==
		Enum.UserInputType.Touch then

		updateJoystick(input.Position)

	end

end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.Touch then

		FlyDragging = false
		FlyDirection = Vector2.zero

		Stick.Position =
			UDim2.new(.5,-30,.5,-30)

	end

end)

--========================================================
-- FLY LOOP
--========================================================

RunService.RenderStepped:Connect(function()

	if not Fly or not Root then
		FlyBase.Visible = false
		return
	end

	FlyBase.Visible = true

	local Camera =
		workspace.CurrentCamera

	local Direction = Vector3.zero

	if FlyDirection.Magnitude > .05 then

		Direction =
			Camera.CFrame.LookVector *
			(-FlyDirection.Y)

			+ Camera.CFrame.RightVector *
			FlyDirection.X

	end

	if Direction.Magnitude > .05 then

		Root.AssemblyLinearVelocity =
			Direction.Unit * FlySpeed

	else

		Root.AssemblyLinearVelocity =
			Vector3.zero

	end

end)

--========================================================
-- MAIN LOOP
--========================================================

RunService.Heartbeat:Connect(function()

	if not Character or not Humanoid or not Root then
		return
	end

	-- GOD
	if God then

		Humanoid.MaxHealth = 100

		if Humanoid.Health < 100 then
			Humanoid.Health = 100
		end

	end

	-- NOCLIP
	if Noclip then

		for _,part in ipairs(
			Character:GetDescendants()
		) do

			if part:IsA("BasePart") then
				part.CanCollide = false
			end

		end

	end

	-- HOVER
	if Hover and not Fly then

		Root.AssemblyLinearVelocity =
			Vector3.new(0,0,0)

	end

end)

