local function CreateButton(text,icon,callback)

	local Button = Instance.new("TextButton")

	Button.Size = UDim2.new(1,-6,0,55)

	Button.BackgroundColor3 =
		Color3.fromRGB(27,27,33)

	Button.BorderSizePixel = 0

	Button.Text = icon.."   "..text

	Button.TextColor3 =
		Color3.fromRGB(240,240,245)

	Button.Font = Enum.Font.GothamBold

	Button.TextSize = 15

	Button.AutoButtonColor = false

	Button.Parent = Scroll

	local Corner = Instance.new("UICorner")

	Corner.CornerRadius =
		UDim.new(0,13)

	Corner.Parent = Button

	local Stroke = Instance.new("UIStroke")

	Stroke.Color =
		Color3.fromRGB(65,65,75)

	Stroke.Parent = Button

	Button.Activated:Connect(function()

		callback(Button,Stroke)

	end)

	return Button

end

local function Toggle(Button,Stroke,StateValue,Name)

	if StateValue then

		Button.Text =
			Name.."   • AÇIK"

		Button.BackgroundColor3 =
			Color3.fromRGB(125,0,20)

		Stroke.Color =
			Color3.fromRGB(255,30,45)

	else

		Button.Text =
			Name.."   • KAPALI"

		Button.BackgroundColor3 =
			Color3.fromRGB(27,27,33)

		Stroke.Color =
			Color3.fromRGB(65,65,75)

	end

end

