stick.BackgroundColor3 = Color3.fromRGB(150,0,25)
stick.Parent = base
Instance.new("UICorner",stick).CornerRadius = UDim.new(1,0)

local function updateJoystick(pos)
	local center = base.AbsolutePosition + base.AbsoluteSize/2
	local delta = Vector2.new(pos.X-center.X,pos.Y-center.Y)
	local radius = 43

	if delta.Magnitude > radius then
		delta = delta.Unit * radius
	end

	joystick = Vector2.new(delta.X/radius,delta.Y/radius)

	stick.Position = UDim2.new(
		.5,delta.X-31,
		.5,delta.Y-31
	)
end

base.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		updateJoystick(input.Position)
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement
	) then
		updateJoystick(input.Position)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
		joystick = Vector2.zero
		stick.Position = UDim2.new(.5,-31,.5,-31)
	end
end)

