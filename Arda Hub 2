--========================================================
-- BUTTON FUNCTION
--========================================================

local function makeButton(name, icon, callback)

	local Button = Instance.new("TextButton")

	Button.Name = name
	Button.Size = UDim2.new(1,-5,0,55)

	Button.BackgroundColor3 =
		Color3.fromRGB(30,30,38)

	Button.BorderSizePixel = 0

	Button.Text =
		icon.."  "..name.."  •  KAPALI"

	Button.TextColor3 =
		Color3.new(1,1,1)

	Button.TextSize = 15
	Button.Font = Enum.Font.GothamBold
	Button.AutoButtonColor = false

	Button.ZIndex = 40
	Button.Parent = List

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,13)
	Corner.Parent = Button

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(65,65,75)
	Stroke.Parent = Button

	local Enabled = false

	Button.Activated:Connect(function()

		Enabled = not Enabled

		Button:SetAttribute("Enabled",Enabled)

		if Enabled then

			Button.Text =
				icon.."  "..name.."  •  AÇIK"

			Button.BackgroundColor3 =
				Color3.fromRGB(145,0,25)

			Stroke.Color =
				Color3.fromRGB(255,30,45)

		else

			Button.Text =
				icon.."  "..name.."  •  KAPALI"

			Button.BackgroundColor3 =
				Color3.fromRGB(30,30,38)

			Stroke.Color =
				Color3.fromRGB(65,65,75)

		end

		callback(Enabled)

	end)

	return Button
end

