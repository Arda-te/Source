local Forward =
	FlyButton("▲",95,65)

local Left =
	FlyButton("◀",20,65)

local Right =
	FlyButton("▶",170,65)

local Up =
	FlyButton("⬆",95,0)

local Down =
	FlyButton("⬇",95,130)

local Back =
	FlyButton("▼",95,65)

local HoldState = {

	Forward=false,
	Left=false,
	Right=false,
	Up=false,
	Down=false,
	Back=false
}

local function Hold(Button,Name)

	Button.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.Touch
			or input.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			HoldState[Name] = true

		end

	end)

	Button.InputEnded:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.Touch
			or input.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			HoldState[Name] = false

		end

	end)

end

Hold(Forward,"Forward")
Hold(Back,"Back")
Hold(Left,"Left")
Hold(Right,"Right")
Hold(Up,"Up")
Hold(Down,"Down")

--====================================================
-- MAIN LOOP
--====================================================

RunService.Heartbeat:Connect(function()

	if not Humanoid or not Humanoid.Parent then
		return
	end

	-- ULTRA GOD
	if State.God then

		Humanoid.MaxHealth = 100

		if Humanoid.Health < 100 then
			Humanoid.Health = 100
		end

	end

	-- SPEED

	if State.Speed then
		Humanoid.WalkSpeed = 100
	else
		Humanoid.WalkSpeed = 16
	end

	-- JUMP

	Humanoid.UseJumpPower = true

	if State.Jump then
		Humanoid.JumpPower = 150
	else
		Humanoid.JumpPower = 50
	end

	-- NOCLIP

	if State.Noclip and Character then

		for _,obj in ipairs(
			Character:GetDescendants()
		) do

			if obj:IsA("BasePart") then
				obj.CanCollide = false
			end

		end

	end

	-- FLY

	if State.Fly and Root then

		FlyGui.Visible = true

		local Camera =
			workspace.CurrentCamera

		local Direction =
			Vector3.zero

		if HoldState.Forward then
			Direction +=
				Camera.CFrame.LookVector
		end

		if HoldState.Back then
			Direction -=
				Camera.CFrame.LookVector
		end

		if HoldState.Left then
			Direction -=
				Camera.CFrame.RightVector
		end

		if HoldState.Right then
			Direction +=
				Camera.CFrame.RightVector
		end

		if HoldState.Up then
			Direction +=
				Vector3.new(0,1,0)
		end

		if HoldState.Down then
			Direction -=
				Vector3.new(0,1,0)
		end

		if State.Hover then

			Root.AssemblyLinearVelocity =
				Vector3.zero

		elseif Direction.Magnitude > 0 then

			Root.AssemblyLinearVelocity =
				Direction.Unit * FlySpeed

		else

			Root.AssemblyLinearVelocity =
				Vector3.zero

		end

	else

		FlyGui.Visible = false

	end

end)

